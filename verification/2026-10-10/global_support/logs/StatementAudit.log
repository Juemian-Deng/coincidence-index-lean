@GlobalSupportBound.rational_global_support_bound : ∀ {n : ℕ},
  ∀ R ∈ Matrix.orthogonalGroup (Fin n) ℚ,
    (GlobalSupportBound.nonintegralRows R).card = (GlobalSupportBound.nonintegralColumns R).card ∧
      (GlobalSupportBound.nonintegralColumns R).card ≤ 2 * (RationalResidueConnection.coincidenceSubgroup R).index ∧
        (GlobalSupportBound.nonintegralRows R).card ≤ 2 * (RationalResidueConnection.coincidenceSubgroup R).index
def GlobalSupportBound.nonintegralColumns : {n : ℕ} → Matrix (Fin n) (Fin n) ℚ → Finset (Fin n) :=
fun {n} R => {j | ¬∃ z, ∀ (i : Fin n), R i j = ↑(z i)}
def GlobalSupportBound.nonintegralRows : {n : ℕ} → Matrix (Fin n) (Fin n) ℚ → Finset (Fin n) :=
fun {n} R => GlobalSupportBound.nonintegralColumns R.transpose
def RationalResidueConnection.coincidenceSubgroup : {n : ℕ} → Matrix (Fin n) (Fin n) ℚ → AddSubgroup (Fin n → ℤ) :=
fun {n} R =>
  { carrier := {x | ∃ y, (R.mulVec fun i => ↑(x i)) = fun i => ↑(y i)}, add_mem' := ⋯, zero_mem' := ⋯, neg_mem' := ⋯ }
