def Wang38.PublishedConjecture38I : Prop :=
∀ (p n : ℕ),
  Nat.Prime p → p % 2 = 1 → 0 < n → n ≤ 8 → ∀ (v : IVector n), Admissible p v → ∃ Q, PublishedGeneratedPrimitive p v Q
def Wang38.PublishedConjecture38II : Prop :=
∀ (p n : ℕ),
  Nat.Prime p → p % 2 = 1 → 2 * p + 1 ≤ n → ∀ (v : IVector n), Admissible p v → ¬∃ Q, PublishedGeneratedPrimitive p v Q
def Wang38.PublishedGeneratedPrimitive : {n : ℕ} → ℕ → IVector n → QMatrix n → Prop :=
fun {n} p v Q =>
  Orthogonal Q ∧ Regular Q ∧ ExactLevel p Q ∧ ∃ A, Numerator p Q A ∧ (residueMatrix A).rank = 1 ∧ ColumnsInLine p v A
def Wang38.ExactLevel : {n : ℕ} → ℕ → QMatrix n → Prop :=
fun {n} p Q => 0 < p ∧ ClearsDenominators p Q ∧ ∀ (d : ℕ), 0 < d → ClearsDenominators d Q → p ≤ d
def Wang38.Admissible : {n : ℕ} → ℕ → IVector n → Prop :=
fun {n} p v => FullSupport p v ∧ sumI v % ↑p = 0 ∧ dotI v v % ↑p = 0
def Wang38.FullSupport : {n : ℕ} → ℕ → IVector n → Prop :=
fun {n} p v => ∀ (i : Fin n), v i % ↑p ≠ 0
