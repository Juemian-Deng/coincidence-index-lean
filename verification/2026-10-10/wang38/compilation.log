def Wang38.PublishedConjecture38II : Prop :=
∀ (p n : ℕ),
  Nat.Prime p → p % 2 = 1 → 2 * p + 1 ≤ n → ∀ (v : IVector n), Admissible p v → ¬∃ Q, PublishedGeneratedPrimitive p v Q
def Wang38.PublishedGeneratedPrimitive : {n : ℕ} → ℕ → IVector n → QMatrix n → Prop :=
fun {n} p v Q =>
  Orthogonal Q ∧ Regular Q ∧ ExactLevel p Q ∧ ∃ A, Numerator p Q A ∧ (residueMatrix A).rank = 1 ∧ ColumnsInLine p v A
theorem Wang38.published_conjecture38II : PublishedConjecture38II :=
fun p n hp ho hn v hv hQ =>
  have hp' := ⟨Nat.Prime.two_le hp, ⟨ho, (Nat.prime_def.mp hp).right⟩⟩;
  Exists.casesOn hQ fun Q hQ =>
    have hb :=
      generated_dimension_le_twice_prime hp' v hv.left Q
        (published_generated_implies_basis_generated hp' v hv.left Q hQ);
    published_conjecture38II._proof_1_1 p n ho hn hb
